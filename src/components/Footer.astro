---
import { site } from "../config";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer-inner">
    <p>© {year} {site.name}. Built with Astro · hosted on GitHub Pages.</p>
    <a
      class="webring-link"
      href="https://webring.wonderful.software"
      aria-label="เยี่ยมชมวงแหวนเว็บ"
    >
      <img
        src="https://webring.wonderful.software/webring.svg"
        alt=""
        width="24"
        height="24"
        loading="lazy"
      />
      <span>วงแหวนเว็บ</span>
    </a>
  </div>
</footer>
